# ==============================================
# CollegeAI - Environment Configuration
# ==============================================

# Backend Configuration
# Use your real MongoDB Atlas URI for production; local fallback remains enabled for development.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=college_ai
MONGODB_USE_LOCAL_FALLBACK=true
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & Embedding Configuration
# Providers supported: GEMINI, OPENAI, MOCK (for standalone testing)
LLM_PROVIDER=GEMINI
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash

EMBEDDING_PROVIDER=GEMINI
EMBEDDING_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Vector Search & RAG Tuning
TOP_K=5
RELEVANCE_THRESHOLD=0.70
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_FILE_SIZE_MB=20

# CORS & Server
FRONTEND_URL=http://localhost:3000
PORT=8001
HOST=0.0.0.0

# Document source storage
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# Frontend Configuration (for frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8001
